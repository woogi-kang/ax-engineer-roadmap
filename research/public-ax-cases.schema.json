{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public AX case registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "verified_at",
    "cases",
    "updated_at",
    "review_scope"
  ],
  "properties": {
    "$schema": {
      "const": "./public-ax-cases.schema.json"
    },
    "verified_at": {
      "type": "string",
      "format": "date",
      "description": "Date of the last full catalog review; a partial update must not replace it."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "region",
          "organization",
          "workflow",
          "industry",
          "source_type",
          "deployment_stage",
          "outcome_verification",
          "source_urls",
          "related_cases",
          "review_status",
          "catalog",
          "claims",
          "baseline_deployment_stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[KG][0-9]{2}$"
          },
          "region": {
            "type": "string",
            "minLength": 2
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ko",
              "en"
            ],
            "properties": {
              "ko": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "industry": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "organization-official",
              "joint-official",
              "vendor-customer-case",
              "mixed-official-independent",
              "government-report"
            ]
          },
          "deployment_stage": {
            "description": "Deployment scope reported at source publication, corrected when contradicted by source evidence. Not a claim of live operation at updated_at; prior classifications and reasons remain in correction claims.",
            "enum": [
              "pilot",
              "limited-operation",
              "operation",
              "expanding-operation",
              "adjusted-operation",
              "unknown"
            ]
          },
          "outcome_verification": {
            "enum": [
              "none",
              "self-reported",
              "cross-checked",
              "independently-evaluated"
            ]
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "related_cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "review_status": {
            "enum": [
              "not-rechecked",
              "selected-claims-reviewed",
              "initial-claims-reviewed"
            ],
            "description": "Whether selected follow-up or correction claims are recorded. not-rechecked means the original case-wide evidence has not been reverified; it does not mean no original URL or individual figure was spot-checked."
          },
          "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layout"
            ],
            "description": "Text of this case's section in the Markdown catalogs, printed by scripts/render-public-cases.mjs. It holds only prose that the claims do not record; lines that repeat a claim are assembled from the claim.",
            "properties": {
              "layout": {
                "enum": [
                  "detailed",
                  "summary",
                  "brief"
                ],
                "description": "detailed: labeled points followed by notes. summary: workflow, practice, and evidence points, then a generated claim-record line. brief: workflow and evidence lines generated from the initial-review claim; a point stored here replaces the generated line."
              },
              "heading": {
                "$ref": "#/$defs/localizedText",
                "description": "Section title printed after the case ID. When omitted, the organization name is printed."
              },
              "points": {
                "type": "object",
                "additionalProperties": false,
                "description": "Labeled lines, printed in the order fixed by the renderer. Each layout accepts only its own points.",
                "properties": {
                  "problem": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "verified_workflow": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "recorded_workflow": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "initial_workflow": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "later_change": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "ai_role": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "human_judgment": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "operating_boundary": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "reported_result": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "operating_control": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "evaluation_method": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "roadmap_lesson": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "workflow": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "practice": {
                    "$ref": "#/$defs/catalogText"
                  },
                  "evidence": {
                    "$ref": "#/$defs/catalogText"
                  }
                }
              },
              "notes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/catalogNote"
                }
              }
            }
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/claim"
            }
          },
          "baseline_deployment_stage": {
            "enum": [
              "pilot",
              "limited-operation",
              "operation",
              "expanding-operation",
              "adjusted-operation",
              "unknown"
            ],
            "description": "First recorded classification for this case: the original full-review value for baseline cases, or introduction-time classification for new cases. Corrections reference this preserved value."
          },
          "introduced_at": {
            "type": "string",
            "format": "date",
            "description": "Date this case entered this catalog. Omitted for the preserved baseline catalog."
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_case_ids",
        "scope",
        "baseline_source_count",
        "baseline_case_ids"
      ],
      "properties": {
        "reviewed_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[KG][0-9]{2}$"
          }
        },
        "scope": {
          "const": "selected-claims-only"
        },
        "baseline_source_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of unique introduction-source URLs among preserved baseline cases."
        },
        "baseline_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[KG][0-9]{2}$"
          }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ko",
        "en"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalogText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ko"
      ],
      "description": "One catalog line. en is omitted where the English catalog has no matching line.",
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalogNote": {
      "type": "object",
      "additionalProperties": false,
      "description": "A paragraph after the points. Give either text, or claim with style; the renderer rejects any other combination.",
      "properties": {
        "text": {
          "$ref": "#/$defs/localizedText"
        },
        "claim": {
          "type": "string",
          "pattern": "^[KG][0-9]{2}-[a-z0-9-]+$",
          "description": "ID of a claim in the same case. The paragraph is assembled from that claim."
        },
        "style": {
          "enum": [
            "source-check",
            "review",
            "plain"
          ],
          "description": "source-check: publication and check dates, then the claim statement. review: check date, then the statement, limitations, and numbered sources. plain: the review body with only the claim ID in front."
        }
      }
    },
    "nullableDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "source_urls",
        "published_at",
        "checked_at",
        "access_status",
        "temporal_relation",
        "status",
        "observation_period",
        "sample",
        "method",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[KG][0-9]{2}-[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "baseline-summary",
            "outcome",
            "operating-boundary",
            "deployment-plan",
            "counterevidence",
            "initial-review",
            "source-confirmation"
          ]
        },
        "statement": {
          "$ref": "#/$defs/localizedText"
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "published_at": {
          "$ref": "#/$defs/nullableDate"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "access_status": {
          "enum": [
            "read",
            "not-rechecked",
            "unavailable"
          ]
        },
        "temporal_relation": {
          "enum": [
            "baseline",
            "post-baseline",
            "pre-baseline-new-evidence",
            "current-undated"
          ]
        },
        "status": {
          "enum": [
            "historical-unrechecked",
            "source-reported",
            "study-reported",
            "unknown"
          ]
        },
        "observation_period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "description"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/nullableDate"
            },
            "end": {
              "$ref": "#/$defs/nullableDate"
            },
            "description": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "description"
          ],
          "properties": {
            "size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "description": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "description"
          ],
          "properties": {
            "status": {
              "enum": [
                "reported",
                "not-reported",
                "not-rechecked"
              ]
            },
            "description": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localizedText"
          }
        },
        "deployment_correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "reason"
          ],
          "properties": {
            "from": {
              "enum": [
                "pilot",
                "limited-operation",
                "operation",
                "expanding-operation",
                "adjusted-operation",
                "unknown"
              ],
              "description": "Classification preserved in baseline_deployment_stage, not the result of the preceding correction."
            },
            "to": {
              "enum": [
                "pilot",
                "limited-operation",
                "operation",
                "expanding-operation",
                "adjusted-operation",
                "unknown"
              ],
              "description": "Classification supported by this correction. Historical corrections may differ from the current case classification."
            },
            "reason": {
              "$ref": "#/$defs/localizedText"
            }
          },
          "description": "A source-backed correction to the prior deployment classification; not a new observation of live operation."
        }
      }
    }
  }
}
