{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public AX case registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "verified_at",
    "cases",
    "updated_at",
    "review_scope"
  ],
  "properties": {
    "$schema": {
      "const": "./public-ax-cases.schema.json"
    },
    "verified_at": {
      "type": "string",
      "format": "date",
      "description": "Date of the last full catalog review; a partial update must not replace it."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "region",
          "organization",
          "workflow",
          "industry",
          "source_type",
          "deployment_stage",
          "outcome_verification",
          "source_urls",
          "related_cases",
          "review_status",
          "claims",
          "baseline_deployment_stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[KG][0-9]{2}$"
          },
          "region": {
            "type": "string",
            "minLength": 2
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ko",
              "en"
            ],
            "properties": {
              "ko": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "industry": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "organization-official",
              "joint-official",
              "vendor-customer-case",
              "mixed-official-independent"
            ]
          },
          "deployment_stage": {
            "description": "Deployment scope reported at source publication, corrected when contradicted by source evidence. Not a claim of live operation at updated_at; prior classifications and reasons remain in correction claims.",
            "enum": [
              "pilot",
              "limited-operation",
              "operation",
              "expanding-operation",
              "adjusted-operation",
              "unknown"
            ]
          },
          "outcome_verification": {
            "enum": [
              "none",
              "self-reported",
              "cross-checked",
              "independently-evaluated"
            ]
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "related_cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "review_status": {
            "enum": [
              "not-rechecked",
              "selected-claims-reviewed"
            ],
            "description": "Whether selected follow-up or correction claims are recorded. not-rechecked means the original case-wide evidence has not been reverified; it does not mean no original URL or individual figure was spot-checked."
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/claim"
            }
          },
          "baseline_deployment_stage": {
            "enum": [
              "pilot",
              "limited-operation",
              "operation",
              "expanding-operation",
              "adjusted-operation",
              "unknown"
            ],
            "description": "Preserved classification from the last full catalog review. Each correction references this baseline; earlier correction claims remain historical records."
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_case_ids",
        "scope",
        "baseline_source_count"
      ],
      "properties": {
        "reviewed_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[KG][0-9]{2}$"
          }
        },
        "scope": {
          "const": "selected-claims-only"
        },
        "baseline_source_count": {
          "const": 26
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ko",
        "en"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nullableDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "source_urls",
        "published_at",
        "checked_at",
        "access_status",
        "temporal_relation",
        "status",
        "observation_period",
        "sample",
        "method",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[KG][0-9]{2}-[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "baseline-summary",
            "outcome",
            "operating-boundary",
            "deployment-plan",
            "counterevidence"
          ]
        },
        "statement": {
          "$ref": "#/$defs/localizedText"
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "published_at": {
          "$ref": "#/$defs/nullableDate"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "access_status": {
          "enum": [
            "read",
            "not-rechecked",
            "unavailable"
          ]
        },
        "temporal_relation": {
          "enum": [
            "baseline",
            "post-baseline",
            "pre-baseline-new-evidence",
            "current-undated"
          ]
        },
        "status": {
          "enum": [
            "historical-unrechecked",
            "source-reported",
            "study-reported",
            "unknown"
          ]
        },
        "observation_period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "description"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/nullableDate"
            },
            "end": {
              "$ref": "#/$defs/nullableDate"
            },
            "description": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "description"
          ],
          "properties": {
            "size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "description": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "description"
          ],
          "properties": {
            "status": {
              "enum": [
                "reported",
                "not-reported",
                "not-rechecked"
              ]
            },
            "description": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localizedText"
          }
        },
        "deployment_correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "reason"
          ],
          "properties": {
            "from": {
              "enum": [
                "pilot",
                "limited-operation",
                "operation",
                "expanding-operation",
                "adjusted-operation",
                "unknown"
              ],
              "description": "Classification preserved in baseline_deployment_stage, not the result of the preceding correction."
            },
            "to": {
              "enum": [
                "pilot",
                "limited-operation",
                "operation",
                "expanding-operation",
                "adjusted-operation",
                "unknown"
              ],
              "description": "Classification supported by this correction. Historical corrections may differ from the current case classification."
            },
            "reason": {
              "$ref": "#/$defs/localizedText"
            }
          },
          "description": "A source-backed correction to the prior deployment classification; not a new observation of live operation."
        }
      }
    }
  }
}
