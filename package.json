{
  "name": "ax-engineer-roadmap",
  "version": "0.4.0",
  "private": true,
  "description": "Practical AX Engineer roadmap in Korean and English",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "bootstrap": "npm ci --ignore-scripts",
    "generate:cases": "node scripts/generate-case-boundary-blocks.mjs",
    "generate:hiring-monthly": "node scripts/render-hiring-monthly.mjs",
    "generate:failure-links": "node scripts/generate-failure-case-links.mjs",
    "check:docs": "node scripts/check-links.mjs && node scripts/check-roadmap.mjs && node scripts/check-public-cases.mjs && npm run check:failures && npm run check:hiring",
    "check:hiring": "node scripts/check-hiring-signals.mjs && node scripts/render-hiring-monthly.mjs --check",
    "check:failures": "node scripts/check-failure-cases.mjs && node scripts/generate-failure-case-links.mjs --check",
    "check:cases": "node scripts/check-cases.mjs && node scripts/generate-case-boundary-blocks.mjs --check",
    "check:copy": "node scripts/check-korean-copy-sync.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:external": "node scripts/check-external-links.mjs",
    "check:readme": "node scripts/check-readme-rendering.mjs",
    "check": "npm run check:docs && npm run check:cases && npm run check:copy && npm run check:version && npm run check:readme",
    "test:research": "node --test scripts/check-public-cases.test.mjs scripts/check-failure-cases.test.mjs",
    "test:hiring": "node --test scripts/check-hiring-signals.test.mjs scripts/render-hiring-monthly.test.mjs",
    "test:readme": "node --test scripts/check-korean-copy-sync.test.mjs",
    "test:python": "python3 -m unittest discover -s case-studies/beauty-d2c-voc/tests -p 'test_*.py' -v && python3 case-studies/beauty-d2c-voc/pipeline/run_pipeline.py --verify-committed",
    "audit": "npm audit --audit-level=high",
    "validate": "npm run check && npm run test:research && npm run test:hiring && npm run test:readme && npm run test:python && npm run audit",
    "verify": "npm run bootstrap && npm run validate"
  },
  "license": "MIT",
  "devDependencies": {
    "marked": "18.1.1"
  }
}
