{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woogi-kang.github.io/ax-engineer-roadmap/case-studies/_schema/case.schema.json",
  "title": "AX Engineer Roadmap case metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "type",
    "primary_domain",
    "industry",
    "difficulty",
    "capabilities",
    "recommended_after",
    "learning_order",
    "status",
    "evidence_stage",
    "readiness",
    "risk",
    "entry_channels",
    "systems",
    "current_write_impact",
    "designed_write_impact",
    "current_autonomy",
    "designed_autonomy",
    "implemented_project_stages",
    "designed_project_stages",
    "verified_at",
    "owner",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "const": "../_schema/case.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "type": {
      "enum": ["workflow", "shared-integration", "organizational-capstone"]
    },
    "primary_domain": {
      "enum": [
        "customer-revenue",
        "people-collaboration",
        "finance-procurement",
        "data-operations",
        "shared-operations"
      ]
    },
    "industry": {
      "enum": [
        "cross-industry",
        "consumer-retail",
        "public-sector",
        "financial-services",
        "manufacturing",
        "healthcare-social-care",
        "legal-life-sciences"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "workflow-discovery",
          "data-contracts",
          "retrieval-analysis",
          "document-processing",
          "human-approval",
          "saas-integration",
          "identity-access",
          "transaction-reconciliation",
          "policy-checks",
          "master-data-controls",
          "event-driven-operations",
          "evaluation",
          "observability",
          "audit",
          "recovery",
          "reuse-governance"
        ]
      }
    },
    "recommended_after": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "learning_order": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "ready", "archived"]
    },
    "evidence_stage": {
      "enum": [
        "simulation-design",
        "public-simulation",
        "anonymized-practice",
        "limited-pilot",
        "operating-evidence"
      ]
    },
    "readiness": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["low", "saas", "it"]
      }
    },
    "risk": {
      "enum": ["low", "moderate", "high"]
    },
    "entry_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_write_impact": {
      "description": "External-system write impact demonstrated by the currently published artifacts.",
      "enum": [
        "none",
        "draft-only",
        "approved-sandbox-write",
        "approved-limited-write",
        "mixed"
      ]
    },
    "designed_write_impact": {
      "description": "Maximum external-system write impact covered by the case design.",
      "enum": [
        "none",
        "draft-only",
        "approved-sandbox-write",
        "approved-limited-write",
        "mixed"
      ]
    },
    "current_autonomy": {
      "description": "Autonomy demonstrated by the currently published artifacts.",
      "type": "string",
      "pattern": "^A[0-4](?:-A[0-4])?$"
    },
    "designed_autonomy": {
      "description": "Maximum autonomy range covered by the case design.",
      "type": "string",
      "pattern": "^A[0-4](?:-A[0-4])?$"
    },
    "implemented_project_stages": {
      "description": "P1-P5 stages demonstrated by the currently published artifacts.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "designed_project_stages": {
      "description": "P1-P5 stages covered by the case design.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
